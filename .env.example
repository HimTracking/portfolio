# Configure SMTP to enable the Contact form to email Ashish directly.
# For Gmail, create an App Password (do not use your normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=your-sending-gmail-address@gmail.com
